<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <PropertyGroup>
    <HonuaSdkDotNetTrainVersion>2.2.0</HonuaSdkDotNetTrainVersion>
    <HonuaMobileVersion>0.1.0-alpha.1</HonuaMobileVersion>
    <MauiVersion>10.0.130</MauiVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Honua.Sdk.Field" Version="$(HonuaSdkDotNetTrainVersion)" />
    <PackageVersion Include="Honua.Mobile.Sdk" Version="$(HonuaMobileVersion)" />
    <PackageVersion Include="Honua.Mobile.Offline" Version="$(HonuaMobileVersion)" />
    <PackageVersion Include="Honua.Mobile.Maui" Version="$(HonuaMobileVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="SkiaSharp" Version="4.156.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.156.1" />
  </ItemGroup>

  <!-- Storage / crypto. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="11.0.0" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
  </ItemGroup>

  <!-- App / MAUI runtime. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="11.0.0" />
    <PackageVersion Include="Plugin.Maui.Audio" Version="4.0.0" />
    <PackageVersion Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <!-- Test stack. -->
  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
    <PackageVersion Include="coverlet.msbuild" Version="10.1.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>
</Project>
