<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Honua.Collect.App.Views.PagedInboxPullPage"
             Title="Paged Inbox Pull">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Padding="16,12" RowSpacing="10">

        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label Text="{Binding StatusSummary}" FontAttributes="Bold" />
            <Label Text="{Binding LastError}" FontSize="12" TextColor="Red" />
        </VerticalStackLayout>

        <Label Grid.Row="1" Text="Latest page classifications" FontSize="13" TextColor="Gray" />

        <CollectionView Grid.Row="2" ItemsSource="{Binding LatestPageRows}"
                        EmptyView="No pages pulled in this session yet.">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="4,8" ColumnDefinitions="*,Auto">
                        <Label Text="{Binding ObjectId, StringFormat='Object #{0}'}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding Disposition}" FontSize="12" TextColor="Gray" VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="3"
               Text="{Binding ConflictCount, StringFormat='Conflicts detected this session: {0}'}"
               FontSize="12" TextColor="#B71C1C" />

        <Grid Grid.Row="4" ColumnDefinitions="*,*" ColumnSpacing="10">
            <Button Text="Resume pull" Command="{Binding ResumeCommand}" />
            <Button Grid.Column="1" Text="Pull from start" Command="{Binding PullFromStartCommand}" />
        </Grid>

    </Grid>

</ContentPage>
