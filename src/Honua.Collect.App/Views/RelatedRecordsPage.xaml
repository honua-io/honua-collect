<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Honua.Collect.App.Views.RelatedRecordsPage"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="{Binding Header}" FontAttributes="Bold" />

            <Label Text="{Binding StatusMessage}" FontSize="12" TextColor="#2E7D32" />

            <Label Text="Linked child records" FontSize="13" TextColor="Gray" />
            <CollectionView ItemsSource="{Binding Children}" EmptyView="No child records linked yet.">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8,10" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding DisplayLabel}" FontAttributes="Bold" />
                                <Label Text="{Binding Subtitle}" FontSize="12" TextColor="Gray" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Unlink" Clicked="OnUnlinkClicked" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Border Padding="12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Create new child record" FontAttributes="Bold" />
                    <Entry Text="{Binding NewChildLabel, Mode=TwoWay}" Placeholder="Child label (optional)" />
                    <Button Text="Add new child" Command="{Binding CreateChildCommand}" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Link existing child record" FontAttributes="Bold" />
                    <Entry Text="{Binding ExistingRecordId, Mode=TwoWay}" Placeholder="Existing record ID" />
                    <Entry Text="{Binding ExistingRecordLabel, Mode=TwoWay}" Placeholder="Display label (optional)" />
                    <Button Text="Link existing" Command="{Binding LinkExistingCommand}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
