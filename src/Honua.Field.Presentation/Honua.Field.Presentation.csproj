<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Honua.Field.Presentation</RootNamespace>
  </PropertyGroup>

  <!--
    Platform-neutral MVVM presentation layer. The MAUI app (Honua.Field.App)
    binds its XAML to these view-models; keeping them free of any MAUI dependency
    means the entire screen logic — dynamic form rendering, sync center, inbox,
    conflict review, map capture — is unit-testable without a device.
  -->
  <ItemGroup>
    <PackageReference Include="Honua.Sdk.Field" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <PackageReference Include="SkiaSharp" />
    <ProjectReference Include="..\Honua.Field.Core\Honua.Field.Core.csproj" />
  </ItemGroup>

</Project>
