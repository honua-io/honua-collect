<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Honua.Field.App.Views.RecordsPage"
             x:Name="Records"
             Title="Records">

    <CollectionView ItemsSource="{Binding VisibleGroups}" IsGrouped="True"
                    SelectionMode="Single" SelectionChanged="OnRecordSelected">
        <CollectionView.Header>
            <Label Text="{Binding BindingContext.Header, Source={x:Reference Records}}"
                   Padding="16,12,16,4" FontAttributes="Bold" />
        </CollectionView.Header>
        <CollectionView.GroupHeaderTemplate>
            <DataTemplate>
                <Label Text="{Binding Title}" Padding="16,10,16,2" FontSize="13" TextColor="Gray"
                       SemanticProperties.HeadingLevel="Level2" />
            </DataTemplate>
        </CollectionView.GroupHeaderTemplate>
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Grid Padding="16,10" ColumnDefinitions="*,*">
                    <Label Text="{Binding Record.RecordId}" IsVisible="{Binding HasRecord}"
                           VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding Record.StatusText}" IsVisible="{Binding HasRecord}"
                           FontSize="12" TextColor="Gray" VerticalOptions="Center" HorizontalTextAlignment="End" />
                    <Label Grid.ColumnSpan="2" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}" />
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>
