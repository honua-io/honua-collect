<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Honua.Field.App.Views.RecordHistoryPage"
             Title="Edit History">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="{Binding RecordId, StringFormat='Record: {0}'}" FontAttributes="Bold" />

            <Label Text="{Binding StatusMessage}" FontSize="12" TextColor="#2E7D32" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="Undo last change" Command="{Binding UndoLastChangeCommand}" />
                <Button Grid.Column="1" Text="Revert to original" Command="{Binding RevertToOriginalCommand}" />
            </Grid>

            <Label Text="Version history (newest first)" FontSize="13" TextColor="Gray" />
            <CollectionView ItemsSource="{Binding Versions}" EmptyView="No edits recorded yet.">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12" Margin="0,4">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding Header}" FontAttributes="Bold" />
                                <Label Text="{Binding Note}" FontSize="12" TextColor="Gray" />
                                <VerticalStackLayout Spacing="2" BindableLayout.ItemsSource="{Binding Changes}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Label Text="{Binding Summary}" FontSize="12" />
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                                <Button Text="{Binding RevertLabel}" Clicked="OnRevertVersionClicked" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
